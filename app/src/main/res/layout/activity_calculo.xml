<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <!-- Barra superior: botón de regreso y chip de idioma -->
    <LinearLayout
        android:id="@+id/barra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_barra"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_volver"
            app:srcCompat="@drawable/ic_flecha_izq"
            app:tint="@color/blanco" />

        <TextView
            style="@style/TextoTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/blanco"
            android:textSize="26sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/chipIdioma"
            style="@style/BotonChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cd_cambiar_idioma"
            android:text="@string/idioma_chip" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="40dp">

            <!-- Título y leyenda del cálculo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icono_titulo">

                        <ImageView
                            android:id="@+id/imgIcono"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            app:tint="@color/blanco" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtTitulo"
                        style="@style/TextoTitulo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:textSize="24sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtLeyenda"
                    style="@style/TextoCuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- Fórmula (imagen que cambia con el cálculo y con el idioma) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_formula"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/formula_etiqueta"
                    android:textColor="@color/principal"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Imagen de la fórmula al 85% del ancho de la tarjeta, centrada. -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <ImageView
                        android:id="@+id/imgFormula"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:maxHeight="240dp"
                        android:scaleType="fitCenter"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.85" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <!-- Formulario dinámico: 2 renglones de hasta 3 campos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="16dp"
                android:paddingEnd="12dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:baselineAligned="false"
                    android:id="@+id/filaUno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/campo1"
                        layout="@layout/item_campo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/campo2"
                        layout="@layout/item_campo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/campo3"
                        layout="@layout/item_campo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:baselineAligned="false"
                    android:id="@+id/filaDos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/campo4"
                        layout="@layout/item_campo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/campo5"
                        layout="@layout/item_campo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/campo6"
                        layout="@layout/item_campo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- Error que depende de varios campos (por ejemplo, sistema sin solución única) -->
                <TextView
                    android:id="@+id/txtErrorGeneral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="4dp"
                    android:accessibilityLiveRegion="polite"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/ic_alerta_circulo"
                    android:drawableTint="@color/error"
                    android:gravity="center_vertical"
                    android:text="@string/error_sistema"
                    android:textColor="@color/error"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Acciones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingBottom="10dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCalcular"
                    style="@style/BotonPrincipal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/boton_calcular" />

                <!-- Limpiar y Compartir con el mismo ancho; Compartir solo aparece cuando hay resultado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:clipChildren="false"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnLimpiar"
                        style="@style/BotonSecundario"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_borrador"
                        android:drawableTint="@color/principal"
                        android:text="@string/boton_limpiar" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnCompartir"
                        style="@style/BotonSecundario"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_compartir"
                        android:drawableTint="@color/principal"
                        android:text="@string/boton_compartir"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Resultado (color arena, distinto de la fórmula) -->
            <LinearLayout
                android:id="@+id/tarjetaResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_resultado"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/ic_check_circulo"
                    android:drawableTint="@color/resultado_texto"
                    android:gravity="center_vertical"
                    android:text="@string/resultado_titulo"
                    android:textColor="@color/resultado_texto"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <include
                    android:id="@+id/filaRes1"
                    layout="@layout/item_resultado_fila"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/filaRes2"
                    layout="@layout/item_resultado_fila"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/filaRes3"
                    layout="@layout/item_resultado_fila"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
