<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <!-- Barra superior: subtítulo a la izquierda y chip de idioma a la derecha -->
    <LinearLayout
        android:id="@+id/barra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_barra"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">

        <TextView
            style="@style/TextoTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/blanco"
            android:textSize="28sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/chipIdioma"
            style="@style/BotonChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/cd_cambiar_idioma"
            android:text="@string/idioma_chip" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Pregunta dentro de una pastilla blanca a la izquierda; va en una sola línea y se achica hasta 16sp si no cabe -->
            <TextView
                android:id="@+id/txtSubtitulo"
                style="@style/TextoTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:accessibilityHeading="true"
                android:background="@drawable/bg_pastilla"
                android:fontFamily="@font/pixelify_sans_700"
                android:maxLines="1"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="18dp"
                android:paddingBottom="10dp"
                android:text="@string/menu_pregunta"
                android:textColor="@color/principal"
                android:textSize="20sp"
                app:autoSizeMaxTextSize="20sp"
                app:autoSizeMinTextSize="16sp"
                app:autoSizeTextType="uniform" />

            <!-- Espacio libre: ocupa lo que sobra (layout_weight) y centra el bloque del gatito y la nube. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/espacioLibre"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="@dimen/menu_bloque_aire_min"
                android:paddingBottom="@dimen/menu_bloque_aire_min">

                <!-- Bloque del gatito y la nube, en porcentajes (ver dimens.xml). MenuActivity lo encoge si falta alto. -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bloqueGatoNube"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1000:760"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_default="percent"
                    app:layout_constraintWidth_percent="1">

                    <!-- Donde empieza el gato (traslape con la base de la nube) -->
                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/guiaGato"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_percent="@dimen/menu_gato_inicio_vertical" />

                    <ImageView
                        android:id="@+id/imgGato"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:contentDescription="@string/cd_gato"
                        app:layout_constraintDimensionRatio="H,23:18"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/guiaGato"
                        app:layout_constraintWidth_percent="@dimen/menu_gato_ancho"
                        app:srcCompat="@drawable/ic_gato" />

                    <!-- Proporción 612:461 = 153:115.25, el tamaño recortado de ic_nube -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/nube"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        app:layout_constraintDimensionRatio="H,612:461"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="@dimen/menu_nube_ancho">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:importantForAccessibility="no"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/ic_nube" />

                        <!-- Zona del texto dentro de la nube (porcentajes sobre el dibujo recortado) -->
                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/guiaIzq"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintGuide_percent="0.15" />

                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/guiaDer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintGuide_percent="0.89" />

                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/guiaArriba"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layout_constraintGuide_percent="0.22" />

                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/guiaAbajo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layout_constraintGuide_percent="0.68" />

                        <TextView
                            android:id="@+id/txtNube"
                            style="@style/TextoTitulo"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:accessibilityLiveRegion="polite"
                            android:gravity="center"
                            android:maxLines="@integer/menu_nube_max_lineas"
                            android:textSize="19sp"
                            app:autoSizeMaxTextSize="19sp"
                            app:autoSizeMinTextSize="13sp"
                            app:autoSizeTextType="uniform"
                            app:layout_constraintBottom_toBottomOf="@id/guiaAbajo"
                            app:layout_constraintEnd_toEndOf="@id/guiaDer"
                            app:layout_constraintStart_toStartOf="@id/guiaIzq"
                            app:layout_constraintTop_toTopOf="@id/guiaArriba" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Cuadrícula de 2 x 2 con alto fijo por tarjeta. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/tarjeta_alto"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tarjeta1"
                    layout="@layout/item_tarjeta_calculo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/menu_mitad_separacion_columnas"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/tarjeta2"
                    layout="@layout/item_tarjeta_calculo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/menu_mitad_separacion_columnas"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/tarjeta_alto"
                android:layout_marginTop="@dimen/menu_separacion_filas"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tarjeta3"
                    layout="@layout/item_tarjeta_calculo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/menu_mitad_separacion_columnas"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/tarjeta4"
                    layout="@layout/item_tarjeta_calculo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/menu_mitad_separacion_columnas"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Botón pegado abajo. -->
    <FrameLayout
        android:id="@+id/pie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAbrir"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableEnd="@drawable/ic_flecha_der"
            android:drawableTint="@color/blanco"
            android:text="@string/boton_abrir" />
    </FrameLayout>
</LinearLayout>
