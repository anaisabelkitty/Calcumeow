<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta del menú; el estado "selected" cambia su fondo y el color del nombre. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tarjeta"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="@dimen/tarjeta_padding_vertical"
    android:paddingEnd="14dp"
    android:paddingBottom="@dimen/tarjeta_padding_vertical">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icono_tarjeta">

        <ImageView
            android:id="@+id/imgIcono"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/principal" />
    </FrameLayout>

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tarjeta_separacion_icono_texto"
        android:gravity="center_horizontal|top"
        android:minLines="@integer/menu_tarjeta_min_lineas"
        android:textAlignment="center"
        android:textColor="@color/tarjeta_texto"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>